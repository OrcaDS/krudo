# Copy to .env and fill in. Every variable read by config/settings.py is listed here.
# All are optional: empty or unset means the default shown.

# Logging
LOG_LEVEL=INFO

# Root directory for the local lake (bronze/ lives under it)
LAKE_ROOT=./lake

# DOE NCR retail pump price listing
DOE_LISTING_URL=https://doe.gov.ph/data-and-prices/liquid-fuels/retail-pump-prices/ncr-pump-prices
HTTP_USER_AGENT=krudo/0.1 (+https://github.com/OrcaDS/krudo)
# Seconds between requests to DOE; at least 5
REQUEST_DELAY_SECONDS=5
